/**
 * Cookie-free YouTube downloader.
 *
 * YouTube does not apply the same bot checks to every Innertube client.  Do
 * not pass all clients in one extractor-args value: yt-dlp may merge them and
 * select a challenged client before the usable formats are returned.  Trying
 * them one at a time also makes this work without asking the user to log in.
 */
const fs = require("fs");
const path = require("path");
const youtubedl = require("youtube-dl-exec");
const ffmpegPath = require("ffmpeg-static");
const { normalizeUrl, DownloaderError } = require("./urlUtils");
const { toDownloaderError } = require("./ytdlp");

const DOWNLOAD_DIR = path.join(__dirname, "youtube_downloads");
const CLIENTS = (process.env.YOUTUBE_PLAYER_CLIENTS ||
  "tv_embedded,ios,android,web_embedded")
  .split(",")
  .map((client) => client.trim())
  .filter(Boolean);
const BOT_ERROR = /sign in to confirm|not a bot|bot challenge|confirm you're not a bot/i;
const MAX_MUX_DURATION_SECONDS = 20 * 60;
const FORMAT_SELECTOR =
  "bestvideo[vcodec^=avc1][height<=720]+bestaudio[acodec^=mp4a]/" +
  "best[vcodec^=avc1][height<=720]/bestvideo[height<=720]+bestaudio/" +
  "best[height<=720]";

if (!fs.existsSync(DOWNLOAD_DIR)) {
  fs.mkdirSync(DOWNLOAD_DIR, { recursive: true });
}

function extractorArgs(client) {
  return `youtube:player_client=${client}`;
}

function isMediaUrl(url) {
  return (
    typeof url === "string" &&
    /^https?:\/\//i.test(url) &&
    !/^blob:|^data:/i.test(url) &&
    !/sabr=1/i.test(url)
  );
}

function hasAudio(format) {
  return format.acodec && format.acodec !== "none";
}

function hasVideo(format) {
  return format.vcodec && format.vcodec !== "none";
}

/**
 * Reduce any single-video link (youtu.be, /shorts/, /live/, /embed/,
 * m.youtube.com, music.youtube.com, watch?v=..&list=..) to the plain watch
 * URL, dropping share params like ?si= and the mix/radio list. Playlist-only
 * links have no video id and are returned unchanged.
 */
function canonicalUrl(url) {
  const parsed = new URL(url);
  const id =
    (parsed.hostname.endsWith("youtu.be") && parsed.pathname.split("/")[1]) ||
    parsed.searchParams.get("v") ||
    (parsed.pathname.match(/^\/(?:shorts|live|embed|v)\/([\w-]{6,})/) || [])[1];
  return id ? `https://www.youtube.com/watch?v=${id}` : url;
}

async function getInfo(url) {
  let lastError;
  for (const client of CLIENTS) {
    try {
      let info = await youtubedl(url, {
        dumpSingleJson: true,
        noWarnings: true,
        noCheckCertificates: true,
        noPlaylist: true,
        // Only matters for a playlist-only link: take its first video.
        playlistItems: "1",
        extractorArgs: extractorArgs(client),
      });
      if (Array.isArray(info.entries)) info = info.entries[0] || {};
      if (Array.isArray(info.formats) && info.formats.some((format) => isMediaUrl(format.url))) {
        return { info, client };
      }
      lastError = new Error(`The ${client} client returned no downloadable formats.`);
    } catch (error) {
      lastError = error;
      if (!BOT_ERROR.test(error.message || "")) {
        throw error;
      }
      console.warn(`YouTube client ${client} was challenged; trying the next client.`);
    }
  }

  throw lastError || new Error("No anonymous YouTube client is available.");
}

/**
 * Download a YouTube video without cookies or an authenticated account.
 * @param {string} url
 * @param {string} [baseUrl]
 * @returns {Promise<{thumbnail: string|null, title: string, formats: Array}>}
 */
async function downloadYouTube(url, baseUrl = "") {
  try {
    url = canonicalUrl(normalizeUrl(url));
    const { info, client } = await getInfo(url);
    if (info.id) url = `https://www.youtube.com/watch?v=${info.id}`;
    const formats = info.formats || [];
    const progressive = formats
      .filter((format) => hasAudio(format) && hasVideo(format) && isMediaUrl(format.url))
      .sort((a, b) => (b.height || 0) - (a.height || 0))[0];
    const bestAudio = formats
      .filter((format) => hasAudio(format) && !hasVideo(format) && isMediaUrl(format.url))
      .sort((a, b) => (b.abr || 0) - (a.abr || 0))[0];
    const bestVideoOnly = formats
      .filter((format) => hasVideo(format) && !hasAudio(format) && isMediaUrl(format.url))
      .sort((a, b) => (b.height || 0) - (a.height || 0))[0];
    const resultFormats = [];

    if (info.is_live) {
      // A stream that's still running has no file to mux (the download below
      // would just run into its timeout); the HLS manifest is all there is.
      const live = formats.filter((format) => isMediaUrl(format.manifest_url)).pop();
      if (live) resultFormats.push({ quality: "live (m3u8)", videoUrl: live.manifest_url });
    } else if (info.duration && info.duration > MAX_MUX_DURATION_SECONDS) {
      if (bestVideoOnly && (!progressive || bestVideoOnly.height > progressive.height)) {
        resultFormats.push({
          quality: `${bestVideoOnly.height}p (video only)`,
          videoUrl: bestVideoOnly.url,
        });
      }
      // Too long to mux here, so also offer the lower-quality file that has sound.
      if (progressive) {
        resultFormats.push({ quality: `${progressive.height}p`, videoUrl: progressive.url });
      }
    } else {
      const filename = `${info.id || Date.now()}-${Date.now()}.mp4`;
      const outputPath = path.join(DOWNLOAD_DIR, filename);
      try {
        await youtubedl(
          url,
          {
            format: FORMAT_SELECTOR,
            mergeOutputFormat: "mp4",
            output: outputPath,
            ffmpegLocation: ffmpegPath,
            noWarnings: true,
            noCheckCertificates: true,
            noPlaylist: true,
            extractorArgs: extractorArgs(client),
          },
          { timeout: 5 * 60 * 1000 }
        );
      } catch (muxError) {
        // YouTube sometimes 403s the stream download even though the metadata
        // came back fine; the direct URLs below are still worth returning.
        console.warn("YouTube mux failed, returning direct URLs:", muxError.message);
      }
      if (fs.existsSync(outputPath)) {
        resultFormats.push({
          quality: "720p",
          videoUrl: `${baseUrl}/youtube-downloads/${filename}`.replace(/([^:]\/)\/+/g, "$1"),
        });
      } else if (progressive) {
        resultFormats.push({ quality: `${progressive.height}p`, videoUrl: progressive.url });
      } else if (bestVideoOnly) {
        resultFormats.push({
          quality: `${bestVideoOnly.height}p (video only)`,
          videoUrl: bestVideoOnly.url,
        });
      }
    }

    if (bestAudio) {
      resultFormats.push({ quality: "mp3", videoUrl: bestAudio.url });
    }
    if (!resultFormats.length) {
      throw new DownloaderError("NO_MEDIA", "No downloadable formats found for this video.");
    }

    return {
      thumbnail:
        info.thumbnail ||
        (info.id ? `https://img.youtube.com/vi/${info.id}/maxresdefault.jpg` : null),
      title: info.title || info.id || "YouTube video",
      duration: info.duration || null,
      formats: resultFormats,
    };
  } catch (error) {
    console.error("YouTube download error:", error.message);
    if (BOT_ERROR.test(error.message || "")) {
      throw new DownloaderError(
        "LOGIN_REQUIRED",
        "YouTube challenged every anonymous client. Cookies/login are not required by this API, " +
          "but age-restricted, region-locked, or heavily protected videos cannot be downloaded anonymously."
      );
    }
    const coded = toDownloaderError(error);
    if (coded.code !== "EXTRACTION_FAILED") throw coded;
    throw new Error(`Failed to download YouTube video: ${error.message}`);
  }
}

module.exports = { downloadYouTube };
