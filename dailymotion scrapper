/**
 * Dailymotion Video Downloader Module
 *
 * Uses Dailymotion's own public player metadata endpoint
 * (https://www.dailymotion.com/player/metadata/video/<id>) which returns the
 * direct stream URLs for every quality, so we never have to bounce the user
 * to the Dailymotion page.
 */

const fetch = require("node-fetch");
const { DEFAULT_USER_AGENT } = require("./browser");
const { normalizeUrl, DownloaderError } = require("./urlUtils");
const { muxToFile, MAX_MUX_DURATION_SECONDS } = require("./ytdlp");

const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

function generateString(length) {
  let result = " ";
  for (let i = 0; i < length; i++) {
    result += characters.charAt(Math.floor(Math.random() * characters.length));
  }
  return result;
}

/**
 * Pull the video id out of any Dailymotion URL shape:
 *  - https://www.dailymotion.com/video/x8abcde
 *  - https://dai.ly/x8abcde
 *  - https://www.dailymotion.com/embed/video/x8abcde
 *  - https://geo.dailymotion.com/player.html?video=x8abcde
 *  - https://cdndirector.dailymotion.com/cdn/manifest/video/x8abcde.m3u8
 */
function extractVideoId(url) {
  const patterns = [
    /dailymotion\.com\/(?:[\w-]+\/)*video\/([a-zA-Z0-9]+)/i,
    /dai\.ly\/([a-zA-Z0-9]+)/i,
    /[?&]video=([a-zA-Z0-9]+)/i,
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

function pickThumbnail(meta) {
  const source = meta.posters || meta.thumbnails;
  if (!source || typeof source !== "object") return null;
  // Keys are pixel widths ("120", "240", ... "1080"); take the largest.
  const widths = Object.keys(source)
    .map(Number)
    .filter((n) => !Number.isNaN(n))
    .sort((a, b) => b - a);
  return widths.length ? source[String(widths[0])] : null;
}

/**
 * Download Dailymotion video from URL
 * @param {string} url - Dailymotion video URL
 * @param {string} [baseUrl] - This server's base URL, for the muxed .mp4
 * @returns {Promise<Object>} Video info with thumbnail and formats
 */
async function downloadDailymotion(url, baseUrl = "") {
  try {
    url = normalizeUrl(url);
    const videoId = extractVideoId(url);
    if (!videoId) {
      throw new Error("Could not find a Dailymotion video id in that URL.");
    }

    const response = await fetch(
      `https://www.dailymotion.com/player/metadata/video/${videoId}?embedder=https%3A%2F%2Fwww.dailymotion.com%2Fvideo%2F${videoId}`,
      {
        headers: {
          "User-Agent": DEFAULT_USER_AGENT,
          Referer: "https://www.dailymotion.com/",
          "Accept-Language": "en-US,en;q=0.9",
        },
      }
    );

    if (!response.ok) {
      throw new Error(`Dailymotion metadata request failed (${response.status}).`);
    }

    const meta = await response.json();
    if (meta.error) {
      throw new Error(meta.error.title || "Dailymotion returned an error for this video.");
    }

    const qualities = meta.qualities || {};
    const order = [
      ["1080", "1080p"],
      ["720", "720p"],
      ["480", "480p"],
      ["380", "380p"],
      ["240", "240p"],
      ["auto", "auto"],
    ];

    const seen = new Set();
    const formats = [];
    for (const [key, label] of order) {
      const list = qualities[key];
      const entry = Array.isArray(list) ? list.find((item) => item && item.url) : null;
      if (entry && !seen.has(entry.url)) {
        seen.add(entry.url);
        formats.push({ quality: label, videoUrl: entry.url });
      }
    }

    if (formats.length === 0) {
      throw new Error("No playable streams found for this Dailymotion video.");
    }

    // Dailymotion only publishes HLS playlists now. A playlist isn't a file
    // the app can save (or read a duration from), so for short videos put a
    // real .mp4 first and keep the playlists as the remaining options.
    if (
      formats.every((format) => /\.m3u8(\?|$)/i.test(format.videoUrl)) &&
      meta.duration &&
      meta.duration <= MAX_MUX_DURATION_SECONDS
    ) {
      try {
        const muxedUrl = await muxToFile(`https://www.dailymotion.com/video/${videoId}`, baseUrl);
        formats.unshift({ quality: "720p", videoUrl: muxedUrl });
      } catch (muxError) {
        console.error("Dailymotion mux failed:", muxError.message);
      }
    }

    console.log(formats, `dailymotion`);

    return {
      thumbnail: pickThumbnail(meta),
      title: meta.title || generateString(25),
      duration: meta.duration || null,
      formats,
    };
  } catch (error) {
    console.error("Dailymotion download error:", error.message);
    if (error instanceof DownloaderError) throw error;
    throw new Error(`Failed to download Dailymotion video: ${error.message}`);
  }
}

module.exports = { downloadDailymotion };
